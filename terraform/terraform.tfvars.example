# cp terraform.tfvars.example terraform.tfvars, then edit.

name        = "mc-01"
location    = "hel1" # EU only for cx33; see README before choosing "ash"/"hil"
server_type = "cx33"

ssh_public_key_path = "~/.ssh/id_ed25519.pub"
# ssh_allowed_ips   = ["203.0.113.4/32"]  # lock this down once it works

mc_type       = "PAPER"
mc_version    = "LATEST"
mc_memory     = "6G"
mc_motd       = "A Terraform-provisioned world"
mc_difficulty = "normal"
mc_ops        = ["YourMinecraftName"]
