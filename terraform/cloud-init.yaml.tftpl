#cloud-config
package_update: true

apt:
  sources:
    docker.list:
      source: "deb [arch=$ARCH signed-by=$KEY_FILE] https://download.docker.com/linux/ubuntu $RELEASE stable"
      keyid: 9DC858229FC7DD38854AE2D88D81803C0EBFCD88

packages:
  - docker-ce
  - docker-ce-cli
  - containerd.io
  - docker-compose-plugin

write_files:
  - path: /usr/local/sbin/mount-world
    permissions: "0755"
    content: |
      #!/bin/bash
      # Attach happens after the server boots, so wait for the device to show up.
      set -euo pipefail
      DEV="${volume_device}"

      for _ in $(seq 1 60); do
        if [ -e "$DEV" ]; then break; fi
        sleep 5
      done
      if [ ! -e "$DEV" ]; then
        echo "world volume never appeared at $DEV" >&2
        exit 1
      fi

      # Only format a blank volume. Never reformat one that already has a world on it.
      if ! blkid "$DEV" >/dev/null 2>&1; then
        mkfs.ext4 -L mcworld "$DEV"
      fi

      mkdir -p /mnt/minecraft
      if ! grep -q " /mnt/minecraft " /etc/fstab; then
        echo "$DEV /mnt/minecraft ext4 discard,nofail,defaults 0 0" >> /etc/fstab
      fi
      mount -a

      mkdir -p /mnt/minecraft/data /mnt/minecraft/backups
      chown -R 1000:1000 /mnt/minecraft/data /mnt/minecraft/backups

  - path: /opt/minecraft/compose.yaml
    permissions: "0640"
    content: |
      services:
        mc:
          image: itzg/minecraft-server:latest
          container_name: mc
          restart: unless-stopped
          stop_grace_period: 2m
          tty: true
          stdin_open: true
          ports:
            - "25565:25565"
          environment:
            EULA: "TRUE"
            TYPE: "${mc_type}"
            VERSION: "${mc_version}"
            MEMORY: "${mc_memory}"
            USE_AIKAR_FLAGS: "true"
            MOTD: "${mc_motd}"
            DIFFICULTY: "${mc_difficulty}"
            MAX_PLAYERS: "${mc_max_players}"
            OPS: "${mc_ops}"
            WHITELIST: "${mc_whitelist}"
            ENFORCE_WHITELIST: "${mc_whitelist != "" ? "true" : "false"}"
            ENABLE_RCON: "true"
            RCON_PASSWORD: "${rcon_password}"
            TZ: "UTC"
          volumes:
            - /mnt/minecraft/data:/data

        backup:
          image: itzg/mc-backup:latest
          container_name: mc-backup
          restart: unless-stopped
          depends_on:
            - mc
          environment:
            BACKUP_INTERVAL: "${backup_interval}"
            PRUNE_BACKUPS_DAYS: "${backup_prune_days}"
            INITIAL_DELAY: "2m"
            RCON_HOST: "mc"
            RCON_PASSWORD: "${rcon_password}"
          volumes:
            - /mnt/minecraft/data:/data:ro
            - /mnt/minecraft/backups:/backups

runcmd:
  - /usr/local/sbin/mount-world
  - systemctl enable --now docker
  - docker compose -f /opt/minecraft/compose.yaml up -d
