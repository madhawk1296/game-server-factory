#cloud-config
package_update: true

# Only what ships in Ubuntu's own repos. Docker's repo is added later by a
# script, because cloud-init's apt module fetches keys from keyserver.ubuntu.com
# and a keyserver failure aborts the whole apt phase -- taking the package
# installs down with it. Docker's documented install pulls the key over HTTPS.
packages:
  - ca-certificates
  - curl

write_files:
  # Written before Docker is installed, so the daemon never initialises a
  # data-root on the ephemeral disk and then has to be migrated.
  - path: /etc/docker/daemon.json
    permissions: "0644"
    content: |
      {
        "data-root": "/mnt/docker",
        "log-driver": "json-file",
        "log-opts": { "max-size": "10m", "max-file": "3" }
      }

  - path: /usr/local/sbin/prepare-docker-storage
    permissions: "0755"
    content: |
      #!/bin/bash
      set -euo pipefail
      DEV="${volume_device}"

      for _ in $(seq 1 60); do
        if [ -e "$DEV" ]; then break; fi
        sleep 5
      done
      if [ ! -e "$DEV" ]; then
        echo "block volume never appeared at $DEV" >&2
        exit 1
      fi

      # DigitalOcean automounts attached volumes at /mnt/<name>. Take the device
      # over rather than fight it -- a second mount of a busy device is what
      # silently failed last time.
      CUR=$(findmnt -n -o TARGET --source "$DEV" 2>/dev/null | head -1 || true)
      if [ -n "$CUR" ] && [ "$CUR" != "/mnt/docker" ]; then
        echo "releasing DigitalOcean automount at $CUR"
        umount "$CUR"
      fi

      # Only format a blank volume. Never reformat one holding worlds.
      if ! blkid "$DEV" >/dev/null 2>&1; then
        mkfs.ext4 -L mcdata "$DEV"
      fi

      mkdir -p /mnt/docker
      if ! grep -q " /mnt/docker " /etc/fstab; then
        echo "$DEV /mnt/docker ext4 discard,nofail,defaults 0 2" >> /etc/fstab
      fi
      findmnt -n /mnt/docker >/dev/null 2>&1 || mount /mnt/docker

      # Pelican keeps server data and its node identity under /var/lib and /etc
      # by default, both on the ephemeral root disk. Bind them onto the block
      # volume rather than fighting Pelican's layout: a droplet rebuild would
      # otherwise delete every customer's world and the node's own credentials,
      # while Docker's data sat safely on the volume beside them.
      mkdir -p /mnt/docker/pelican-volumes /mnt/docker/pelican-config
      mkdir -p /var/lib/pelican/volumes /etc/pelican
      grep -q " /var/lib/pelican/volumes " /etc/fstab || \
        echo "/mnt/docker/pelican-volumes /var/lib/pelican/volumes none bind 0 0" >> /etc/fstab
      grep -q " /etc/pelican " /etc/fstab || \
        echo "/mnt/docker/pelican-config /etc/pelican none bind 0 0" >> /etc/fstab
      findmnt -n /var/lib/pelican/volumes >/dev/null 2>&1 || mount /var/lib/pelican/volumes
      findmnt -n /etc/pelican >/dev/null 2>&1 || mount /etc/pelican

      findmnt -n /mnt/docker

  - path: /usr/local/sbin/install-docker
    permissions: "0755"
    content: |
      #!/bin/bash
      set -euo pipefail
      install -m 0755 -d /etc/apt/keyrings
      curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
      chmod a+r /etc/apt/keyrings/docker.asc
      . /etc/os-release
      echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu $VERSION_CODENAME stable" \
        > /etc/apt/sources.list.d/docker.list
      apt-get update -y
      DEBIAN_FRONTEND=noninteractive apt-get install -y docker-ce docker-ce-cli containerd.io

  # Extends the image's own Caddyfile rather than replacing it: same global
  # block and same panel site, plus a second site that terminates TLS for the
  # node and proxies to Wings on the host. Wings therefore never handles a
  # certificate, and the browser console -- which connects directly to Wings,
  # not through the panel -- gets a valid one.
  - path: /opt/pelican/Caddyfile
    permissions: "0644"
    content: |
      {
      	servers {
      		{$CADDY_TRUSTED_PROXIES}
      		{$CADDY_STRICT_PROXIES}
      	}
      	admin off
      	{$CADDY_AUTO_HTTPS}
      	{$CADDY_LE_EMAIL}
      }

      {$CADDY_APP_URL} {
      	root * /var/www/html/public
      	encode gzip

      	file_server
      	php_fastcgi 127.0.0.1:9000
      }

      https://${node_hostname} {
      	reverse_proxy host.docker.internal:8080
      }

  - path: /etc/systemd/system/wings.service
    permissions: "0644"
    content: |
      [Unit]
      Description=Pelican Wings Daemon
      After=docker.service
      Requires=docker.service
      PartOf=docker.service

      [Service]
      User=root
      WorkingDirectory=/etc/pelican
      LimitNOFILE=4096
      PIDFile=/var/run/wings/daemon.pid
      ExecStart=/usr/local/bin/wings
      Restart=on-failure
      StartLimitInterval=180
      StartLimitBurst=30
      RestartSec=5s

      [Install]
      WantedBy=multi-user.target

runcmd:
  - /usr/local/sbin/prepare-docker-storage
  - /usr/local/sbin/install-docker
  - systemctl enable --now docker
  - docker info --format 'data-root={{.DockerRootDir}}'

  # Wings is a host binary, not a container: it drives the Docker socket and
  # binds game ports directly. Enabled only when a config already exists on the
  # volume -- on a first build there is no node yet, and a service crash-looping
  # on a missing file is noise rather than information.
  - mkdir -p /var/log/pelican /var/run/wings
  - curl -fsSL -o /usr/local/bin/wings https://github.com/pelican-dev/wings/releases/latest/download/wings_linux_amd64
  - chmod u+x /usr/local/bin/wings
  - systemctl daemon-reload
  - /usr/local/bin/wings version
  - test -f /etc/pelican/config.yml && systemctl enable --now wings || echo "no node config yet; create a node in the panel first"
