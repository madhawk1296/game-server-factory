# cp terraform.tfvars.example terraform.tfvars, then fill in.
# terraform.tfvars is gitignored -- these are live credentials.

world_domain = "mc.yourdomain.com"

# Cloudflare R2: free under 10 GB, no egress fees.
#   1. dash.cloudflare.com -> R2 -> Create bucket  (name it mc-backups)
#   2. R2 -> Manage API tokens -> Create -> Object Read & Write
#   3. endpoint is https://<account-id>.r2.cloudflarestorage.com
backup_s3 = {
  endpoint   = "https://<account-id>.r2.cloudflarestorage.com"
  bucket     = "mc-backups"
  access_key = "..."
  secret_key = "..."
}

servers = {
  smp = {
    memory_mb = 5120
    motd      = "Survival"
    ops       = ["madhawk1296"]
  }
}
